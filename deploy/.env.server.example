# 서버에서: cp deploy/.env.server.example deploy/.env 뒤 값을 채운다. deploy/.env 는 커밋하지 않는다.

# 이 백엔드 전용 Postgres (트래커 DB 와 따로)
POSTGRES_DB=campus_backend
POSTGRES_USER=campus
# 비어 있으면 compose 가 멈춘다. 예: sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 16)/" deploy/.env
# 볼륨을 처음 만들 때만 적용된다(나중에 바꿔도 DB 비밀번호는 그대로).
POSTGRES_PASSWORD=
# 서버 안에서만 열림(127.0.0.1)
DB_PORT=5435

# API 를 여는 주소와 포트. 0.0.0.0 = 모든 망. Tailscale 로만 열려면 서버의 Tailscale IP
API_BIND=0.0.0.0
API_PORT=8010

# 가져오기 원천: 트래커 읽기 API (컨테이너 안에서 본 주소). 트래커는 Tailscale IP 에만 열려 있어 host.docker.internal 로는 안 닿음
TRACKER_API=http://100.93.21.92:3000

# 브라우저에서 부를 때만 허용 출처(쉼표로). 앱은 필요 없음
CORS_ORIGINS=
